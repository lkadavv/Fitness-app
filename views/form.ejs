<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Додати запис</title>
    <style>
        body { font-family: sans-serif; margin: 40px; background-color: #ddddea; }
        form { max-width: 400px; display: flex; flex-direction: column; gap: 10px; }
        input, select, button { padding: 10px; }
        .error { color: red; }
    </style>
</head>
<body>
    <h1>Запис на тренування</h1>
    
    <% if (locals.error) { %>
        <p class="error"><%= error %></p>
    <% } %>

    <form action="/add" method="POST">
        <input type="text" id="client_name" name="client_name" placeholder="Ваше ім'я" value="<%= locals.formData ? formData.client_name : '' %>">
        <input type="text" id="client_surname" name="client_surname" placeholder="Ваше прізвище" value="<%= locals.formData ? formData.client_surname : '' %>">
        <div class="form-group" style="margin-bottom: 20px;">
            <label>Номер телефону:</label>
            <div style="display: flex; gap: 8px;">
                <select id="country" onchange="initMask()" style="padding: 8px; border-radius: 4px; border: 1px solid #ccc;">
                    <option value="+380" data-placeholder="00 000 00 00" data-length="9" >UA (+380)</option>
                    <option value="+48" data-placeholder="000 000 000" data-length="9">PL (+48)</option>
                    <option value="+1" data-placeholder="000 000 0000" data-length="10">US (+1)</option>
                </select>
                
                <input type="text" id="phone-display" placeholder="00 000 00 00" value="<%= locals.formData ? formData.phone : '' %>"
                       style="flex-grow: 1; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                
                <input type="hidden" name="phone" id="phone-final">
            </div>
        </div>
        
        <select name="class_id">
            <option value="">Оберіть тренування</option>
            <% trainingClasses.forEach(tClass => { 
                let isSelected = (locals.formData && formData.class_id == tClass.id) ? 'selected' : ''; 
            %>
                <option value="<%= tClass.id %>" <%= isSelected %>>
                    <%= tClass.name %> (<%= tClass.intensity %> інтенсивність)
                </option>
            <% }); %>
        </select>

        <button type="submit" style="background: #3ba835; color: white; border: none; cursor: pointer;">Записатися</button>
    </form>
    
    <br>
    <a href="/">Назад до списку</a>
    <script src="/phoneValidation.js"></script>
    <script src="/nameValidation.js"></script>
</body>
</html>